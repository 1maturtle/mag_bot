# ======================================
# Шаблон змінних середовища (.env_example)
# Скопіюй цей файл як .env та заповни реальними значеннями
# ======================================

# Telegram Bot Token (отримай у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Supabase — URL проекту та СЕКРЕТНИЙ ключ (Settings → API Keys → Secret key, sb_secret_...
# або legacy service_role). Publishable/anon ключ (sb_publishable_...) НЕ підійде:
# у схемі ввімкнено RLS, і доступ дозволено лише service_role.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_secret_key_here

# Google Gemini API Key — https://aistudio.google.com/apikey (починається з "AIza")
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (необов'язково)
# GEMINI_MODEL=gemini-2.5-flash
